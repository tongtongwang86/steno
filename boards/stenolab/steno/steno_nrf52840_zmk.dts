/*
 * steno - 27-key steno board, nRF52840, no bootloader.
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include "steno-pinctrl.dtsi"

/ {
	model = "steno";
	compatible = "stenolab,steno";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,battery = &fuelgauge;
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
		zephyr,display = &oled;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <27>;
		rows = <1>;
		map = <
RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)
RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)
RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23) RC(0,24) RC(0,25) RC(0,26)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;
		input-gpios
		= <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio1  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		, <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
		;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};
	};
};

&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twi";
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	fuelgauge: bq274xx@55 {
		compatible = "ti,bq274xx";
		reg = <0x55>;
		design-voltage = <3700>;
		design-capacity = <400>;
		taper-current = <2>;
		terminate-voltage = <2750>;
		int-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		com-invdir;
	};
};

&adc    { status = "okay"; };
&gpiote { status = "okay"; };
&gpio0  { status = "okay"; };
&gpio1  { status = "okay"; };

zephyr_udc0: &usbd { status = "okay"; };

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * No bootloader: the application owns the vector table at 0x0
		 * and is flashed over SWD. Sizes come from measured builds -
		 * see docs/MEMORY_MAP.md.
		 */
		code_partition: partition@0 {
			reg = <0x00000000 0x00044000>;   /* 272K: 194K used */
		};

		dict_partition: partition@44000 {
			reg = <0x00044000 0x000b4000>;   /* 720K: 694K image */
		};

		storage_partition: partition@f8000 {
			reg = <0x000f8000 0x00008000>;   /* 32K: 8 NVS sectors */
		};
	};
};
